{
  "name": "applypilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal job application workspace with evidence-based resume matching and optional Gemini assistance.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "demo": "concurrently -k -n api,web \"npm:demo:server\" \"npm:dev:client\"",
    "demo:server": "node server/src/demo.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write client/src server/src server/test tests *.js *.json *.md docs/*.md",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "vite": "^7.2.2"
  }
}
